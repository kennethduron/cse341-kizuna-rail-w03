<%- include('../partials/header') %>
<h1><%= title %></h1>

<div id="filters" data-selected-region="<%= selectedRegion %>" data-selected-season="<%= selectedSeason %>">
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter"><option value="all">All Regions</option></select>
    <label for="season-filter">Search by Season:</label>
    <select id="season-filter"><option value="all">Any Season</option></select>
</div>

<p id="trips-loading" role="status" aria-live="polite">Loading trips…</p>
<p id="trips-error" role="alert" hidden>Unable to load trips right now. Please try again in a moment.</p>
<p id="trips-empty" role="status" hidden>No trips match your selection.</p>
<div id="trips-list" class="routes-grid" aria-live="polite"></div>

<template id="trip-card-template">
    <article class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>
        <div class="station-info">
            <div class="station"><span class="station-type">From:</span><span class="station-name" data-field="start"></span></div>
            <span class="route-arrow" aria-hidden="true">→</span>
            <div class="station"><span class="station-type">To:</span><span class="station-name" data-field="end"></span></div>
        </div>
        <div class="route-details">
            <div class="detail-item"><span class="detail-icon" aria-hidden="true">◷</span><span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span></div>
            <div class="detail-item"><span class="detail-icon" aria-hidden="true">⌖</span><span><span class="detail-label">Distance:</span> <span data-field="distance"></span> km</span></div>
            <div class="detail-item"><span class="season-badge" data-field="season"></span></div>
        </div>
        <p class="route-description" data-field="description"></p>
        <div class="highlights"><div class="highlights-list" data-field="highlights"></div></div>
        <div class="route-actions"><a class="view-details-btn" data-field="details">View Details &amp; Book →</a></div>
    </article>
</template>

<%- include('../partials/footer') %>
